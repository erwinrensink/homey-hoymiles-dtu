{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "nl.hems.homey",
  "version": "1.0.1",
  "brandColor": "#0f172a",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Hoymiles DTU"
  },
  "description": {
    "en": "Read the data from the Hoymiles DTU and control the inverter power",
    "nl": "Lees de data van de Hoymiles DTU en stuur het vermogen van de omvormer aan"
  },
  "category": [
    "energy"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Erwin Rensink",
    "email": "erwinrensink@gmail.com"
  },
  "flow": {
    "triggers": [
      {
        "id": "power_exceeds",
        "title": {
          "en": "Power exceeds value",
          "nl": "Vermogen komt boven waarde"
        },
        "titleFormatted": {
          "en": "Power exceeds [[limit]] W",
          "nl": "Vermogen komt boven [[limit]] W"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hoymiles-dtu"
          },
          {
            "name": "limit",
            "type": "number",
            "title": {
              "en": "Power (W)",
              "nl": "Vermogen (W)"
            }
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "power_greater_than",
        "title": {
          "en": "Power is greater than",
          "nl": "Vermogen is groter dan"
        },
        "titleFormatted": {
          "en": "Power is greater than [[limit]] W",
          "nl": "Vermogen is groter dan [[limit]] W"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hoymiles-dtu"
          },
          {
            "name": "limit",
            "type": "number",
            "title": {
              "en": "Power (W)",
              "nl": "Vermogen (W)"
            }
          }
        ]
      },
      {
        "id": "temperature_higher_than",
        "title": {
          "en": "Temperature is higher than",
          "nl": "Temperatuur is hoger dan"
        },
        "titleFormatted": {
          "en": "Temperature is higher than [[limit]] °C",
          "nl": "Temperatuur is hoger dan [[limit]] °C"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hoymiles-dtu"
          },
          {
            "name": "limit",
            "type": "number",
            "title": {
              "en": "Temperature (°C)",
              "nl": "Temperatuur (°C)"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_power_limit",
        "title": {
          "en": "Set power limit",
          "nl": "Zet vermogenslimiet"
        },
        "titleFormatted": {
          "en": "Set power limit to [[percentage]]%",
          "nl": "Zet vermogenslimiet op [[percentage]]%"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=hoymiles-dtu"
          },
          {
            "name": "percentage",
            "type": "number",
            "title": {
              "en": "Limit (%)",
              "nl": "Limiet (%)"
            },
            "min": 5,
            "max": 100,
            "units": "%"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Hoymiles DTU",
        "nl": "Hoymiles DTU"
      },
      "class": "solarpanel",
      "capabilities": [
        "meter_power",
        "measure_power"
      ],
      "energy": {
        "measurePowerProducedCapability": "measure_power",
        "meterPowerProducedCapability": "meter_power"
      },
      "platforms": [
        "local"
      ],
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "images": {
        "small": "/drivers/hoymiles-dtu/assets/images/small.png",
        "large": "/drivers/hoymiles-dtu/assets/images/large.png",
        "xlarge": "/drivers/hoymiles-dtu/assets/images/xlarge.png"
      },
      "id": "hoymiles-dtu",
      "settings": [
        {
          "id": "ip",
          "type": "text",
          "label": {
            "en": "IP Address",
            "nl": "IP-adres"
          },
          "value": "192.168.2.73"
        },
        {
          "id": "port",
          "type": "number",
          "label": {
            "en": "Modbus Port",
            "nl": "Modbus-poort"
          },
          "value": 502
        },
        {
          "id": "unitId",
          "type": "number",
          "label": {
            "en": "Unit ID",
            "nl": "Unit ID"
          },
          "value": 1
        }
      ]
    }
  ]
}
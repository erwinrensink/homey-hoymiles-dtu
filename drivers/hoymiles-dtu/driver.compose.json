{
  "name": {
    "en": "Hoymiles DTU",
    "nl": "Hoymiles DTU"
  },
  "class": "solarpanel",
  "capabilities": [
    "meter_power",
    "measure_power"
  ],
  "settings": [
    {
      "id": "ip",
      "type": "text",
      "label": {
        "en": "IP Address",
        "nl": "IP-adres"
      },
      "value": "192.168.1.100"
    },
    {
      "id": "port",
      "type": "number",
      "label": {
        "en": "Port",
        "nl": "Poort"
      },
      "value": 502
    },
    {
      "id": "unitId",
      "type": "number",
      "label": {
        "en": "Unit ID",
        "nl": "Unit ID"
      },
      "value": 1
    }
  ],
  "energy": {
    "measurePowerProducedCapability": "measure_power",
    "meterPowerProducedCapability": "meter_power"
  },
  "platforms": [
    "local"
  ],
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      },
      "options": {
        "singular": true
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  }
}